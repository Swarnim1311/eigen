# Copy to .env (never commit real secrets)
EIGEN_ENV=dev
EIGEN_API_PORT=8000
# Recognizer worker (ml env). Defaults resolve inside the repo; override only if
# your layout differs. The worker loads the experimental PosFormer checkpoint once
# per server lifetime (no licensing clearance claimed — see docs/project_context).
EIGEN_ML_PYTHON=..\ml\.venv\Scripts\python.exe
EIGEN_WORKER=..\ml\scripts\recognizer_worker.py
EIGEN_CKPT=..\ml\checkpoints\posformer-best.ckpt
